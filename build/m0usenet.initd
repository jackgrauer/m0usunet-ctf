#!/sbin/openrc-run
# m0usenet — bring up the fake crazy.ants network and start the
# services that listen on it: dnsmasq, banner responder, fake-Jenkins.

description="m0usenet fake services"

depend() {
    need localmount
    after bootmisc
}

start() {
    ebegin "starting m0usenet"

    # Bring up loopback and add IP aliases for all 12 crazy.ants hosts.
    ip link set lo up 2>/dev/null
    for ip in 10.4.12.1 10.4.12.10 10.4.12.20 10.4.12.21 \
              10.4.12.30 10.4.12.31 10.4.12.40 10.4.12.50 \
              10.4.12.70 10.4.12.80 10.4.12.88 10.4.12.99; do
        ip addr add "${ip}/32" dev lo 2>/dev/null
    done

    # Point the resolver at our local dnsmasq.
    echo "nameserver 127.0.0.1" > /etc/resolv.conf
    # nmap also reads /etc/nsswitch.conf — busybox default is fine.

    # Start dnsmasq with our config.
    start-stop-daemon --start --background --make-pidfile \
        --pidfile /run/m0use-dnsmasq.pid \
        --exec /usr/sbin/dnsmasq -- \
        --keep-in-foreground --conf-file=/etc/m0use-dnsmasq.conf

    # Give dnsmasq a moment to bind 127.0.0.1:53.
    sleep 0.3

    # Banner responder.
    start-stop-daemon --start --background --make-pidfile \
        --pidfile /run/m0use-banners.pid \
        --exec /usr/local/bin/m0use-banners

    # Fake-Jenkins.
    start-stop-daemon --start --background --make-pidfile \
        --pidfile /run/m0use-jenkins.pid \
        --exec /usr/local/bin/m0use-jenkins

    eend 0
}

stop() {
    ebegin "stopping m0usenet"
    for pidfile in /run/m0use-jenkins.pid /run/m0use-banners.pid /run/m0use-dnsmasq.pid; do
        if [ -f "$pidfile" ]; then
            start-stop-daemon --stop --pidfile "$pidfile" --quiet
            rm -f "$pidfile"
        fi
    done
    eend 0
}
